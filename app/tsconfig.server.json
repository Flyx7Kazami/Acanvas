{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "src/server",
    "src/shared",
    "src/cli.ts",
    "tests"
  ]
}
