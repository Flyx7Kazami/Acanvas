  "requests": [
    {
      "text": "Make a 15-second motion study from the bloom.",
      "image": "bloom.png",
      "keys": [
        "bloom"
      ],
      "detail": "Keep the grain, let the petals drift slowly, and leave the title still."
    },
    {
      "text": "Try a softer transition between the sonic sketches.",
      "image": "echo.png",
      "keys": [
        "afterimage",
        "smallhours"
      ],
      "detail": "Bring Afterimage into Small hours with a longer tail and a little more space."
    },
    {
      "text": "Explore the chrome studies for the evening programme.",
      "image": "echo-blue-study.png",
      "group": true,
      "detail": "Use the Image studies group as the starting point for a second programme direction."
    }
  ],
